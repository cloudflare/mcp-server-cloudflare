{
	"name": "containers-mcp",
	"version": "0.2.19",
	"private": true,
	"type": "module",
	"scripts": {
		"check:types": "run-tsc",
		"check:lint": "run-eslint-workers",
		"deploy": "run-wrangler-deploy",
		"dev": "wrangler dev --var ENVIRONMENT:dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"types": "wrangler types",
		"eval:dev": "start-server-and-test --expect 404 eval:server http://localhost:8976 'vitest --testTimeout=60000 --config vitest.config.evals.ts'",
		"eval:server": "wrangler dev --var ENVIRONMENT:test --var DEV_DISABLE_OAUTH:true --var DEV_CLOUDFLARE_EMAIL:mcp-server-eval-account@workers-for-platforms-dev.cfdata.org",
		"eval:ci": "start-server-and-test --expect 404 eval:server http://localhost:8976 'vitest run --testTimeout=60000 --config vitest.config.evals.ts'"
	},
	"dependencies": {
		"@n8n/json-schema-to-zod": "1.1.0",
		"@repo/eval-tools": "workspace:*",
		"@repo/mcp-common": "workspace:*",
		"@repo/mcp-observability": "workspace:*",
		"agents": "catalog:",
		"cron-schedule": "5.0.4",
		"esbuild": "0.27.3",
		"hono": "4.7.6",
		"mime": "4.0.6",
		"simple-git-hooks": "2.12.1",
		"vitest-evals": "0.1.4",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.16.11",
		"@types/node": "22.15.17",
		"ai": "6.0.194",
		"start-server-and-test": "2.0.11",
		"wrangler": "4.148.0"
	}
}
