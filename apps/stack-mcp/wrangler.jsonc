{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/stack-mcp.app.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"name": "mcp-cloudflare-stack-dev",
	"minify": true,
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	// AI Search namespace binding: instances live in the `dev-stack` namespace.
	"ai_search_namespaces": [
		{
			"binding": "AI_SEARCH",
			"namespace": "dev-stack"
		}
	],
	"vars": {
		"ENVIRONMENT": "development",
		"MCP_SERVER_NAME": "PLACEHOLDER",
		"MCP_SERVER_VERSION": "PLACEHOLDER"
	},
	"dev": {
		"port": 8978
	},
	"workers_dev": false,
	"preview_urls": false,
	"analytics_engine_datasets": [
		{
			"binding": "MCP_METRICS",
			"dataset": "mcp-metrics-dev"
		}
	],
	"env": {
		"staging": {
			"name": "mcp-cloudflare-stack-staging",
			"account_id": "6702657b6aa048cf3081ff3ff3c9c52f",
			"routes": [{ "pattern": "stack-staging.mcp.cloudflare.com", "custom_domain": true }],
			"ai_search_namespaces": [
				{
					"binding": "AI_SEARCH",
					"namespace": "dev-stack"
				}
			],
			"vars": {
				"ENVIRONMENT": "staging",
				"MCP_SERVER_NAME": "Cloudflare Developer Stack MCP Server - Staging",
				"MCP_SERVER_VERSION": "0.1.0"
			},
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-staging"
				}
			]
		},
		"production": {
			"name": "mcp-cloudflare-stack-production",
			"account_id": "6702657b6aa048cf3081ff3ff3c9c52f",
			"routes": [{ "pattern": "stack.mcp.cloudflare.com", "custom_domain": true }],
			"ai_search_namespaces": [
				{
					"binding": "AI_SEARCH",
					"namespace": "dev-stack"
				}
			],
			"vars": {
				"ENVIRONMENT": "production",
				"MCP_SERVER_NAME": "Cloudflare Developer Stack MCP Server",
				"MCP_SERVER_VERSION": "0.1.0"
			},
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-production"
				}
			]
		}
	}
}
