{
	"name": "@cloudflare/mcp-server-cloudflare",
	"version": "1.0.0",
	"description": "Monorepo for Cloudflare MCP servers",
	"private": true,
	"license": "Apache-2.0",
	"author": "Cloudflare, Inc. (https://cloudflare.com)",
	"homepage": "https://github.com/cloudflare/mcp-server-cloudflare",
	"bugs": "https://github.com/cloudflare/mcp-server-cloudflare/issues",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"changeset:new": "run-changeset-new",
		"check": "pnpm run check:format && pnpm run lint && pnpm run typecheck && pnpm run test",
		"check:deps": "syncpack lint",
		"check:format": "prettier . --check --cache --ignore-unknown",
		"check:turbo": "run-turbo check",
		"deploy": "run-turbo deploy",
		"deploy:prod": "wrangler deploy --env production",
		"dev": "run-turbo dev --parallel --continue",
		"build": "run-turbo check:types",
		"eval:ci": "run-turbo eval:ci",
		"eval:dev": "run-turbo eval:dev",
		"fix:deps": "run-fix-deps",
		"fix:format": "prettier . --write --cache --ignore-unknown",
		"format": "prettier . --write --cache --ignore-unknown",
		"format:check": "prettier . --check --cache --ignore-unknown",
		"lint": "run-turbo check:lint",
		"seed:prod": "tsx scripts/seed-r2.ts production",
		"seed:staging": "tsx scripts/seed-r2.ts staging",
		"test": "run-turbo test",
		"test:ci": "run-vitest-ci",
		"test:watch": "vitest",
		"typecheck": "run-turbo check:types",
		"types": "wrangler types",
		"update-deps": "syncpack update"
	},
	"dependencies": {
		"@clack/prompts": "0.8.2",
		"@cloudflare/codemode": "0.3.4",
		"@cloudflare/kumo": "2.0.2",
		"@cloudflare/puppeteer": "1.1.0",
		"@cloudflare/sandbox": "0.10.1",
		"@cloudflare/shell": "0.3.6",
		"@cloudflare/think": "0.5.3",
		"@cloudflare/workers-oauth-provider": "*",
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@phosphor-icons/react": "2.1.10",
		"@silvia-odwyer/photon-node": "0.3.3",
		"@xterm/addon-fit": "0.10.0",
		"@xterm/xterm": "5.5.0",
		"agents": "0.12.4",
		"ai": "6.0.174",
		"axios": "1.18.0",
		"chalk": "5.3.0",
		"cors": "2.8.5",
		"express": "5.1.0",
		"fastmcp": "3.14.5",
		"hono": "4.12.32",
		"marked": "14.1.4",
		"mime": "^4.0.7",
		"minimatch": "10.2.5",
		"react": "19.0.0",
		"react-dom": "19.0.0",
		"react-router-dom": "7.14.2",
		"ws": "8.21.0",
		"zod": "4.4.3",
		"zod-to-json-schema": "^3.24.4"
	},
	"devDependencies": {
		"@anthropic-ai/mcpb": "^1.2.0",
		"@changesets/cli": "2.28.1",
		"@cloudflare/vitest-pool-workers": "0.18.6",
		"@ianvs/prettier-plugin-sort-imports": "4.4.1",
		"@modelcontextprotocol/ext-apps": "^1.0.1",
		"@playwright/test": "^1.54.1",
		"@repo/tools": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@sentry/nextjs": "*",
		"@types/fs-extra": "11.0.4",
		"@types/node": "22.15.17",
		"@types/npm-which": "3.0.3",
		"@types/react": "19.0.0",
		"@types/react-dom": "19.0.0",
		"@vitejs/plugin-react": "4.3.4",
		"@vitejs/plugin-rsc": "*",
		"@vitest/coverage-istanbul": "4.1.8",
		"@vitest/ui": "4.1.8",
		"abort-controller": "3.0.0",
		"commander": "^13.1.0",
		"debug": "^4.4.1",
		"esbuild": "0.27.3",
		"fs-extra": "11.2.0",
		"js-tiktoken": "^1.0.21",
		"jsdoc-api": "9.3.4",
		"jsdom": "^24.1.3",
		"just-filter-object": "3.2.0",
		"just-map-values": "3.2.0",
		"msw": "2.14.6",
		"nexe": "^5.0.0-beta.4",
		"nodemon": "^3.0.2",
		"npm-which": "3.0.1",
		"oxfmt": "0.31.0",
		"oxlint": "1.46.0",
		"playwright": "1.54.1",
		"prettier": "3.5.3",
		"prettier-plugin-packagejson": "2.1.1",
		"prettier-plugin-sort-json": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"redoc": "2.5.2",
		"shx": "0.3.4",
		"syncpack": "13.0.3",
		"tmp-promise": "3.0.3",
		"ts-blank-space": "0.4.4",
		"tsup": "8.3.5",
		"tsx": "4.22.4",
		"turbo": "2.10.7",
		"typescript": "5.5.4",
		"vite": "6.3.4",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.8",
		"wrangler": "4.118.0"
	},
	"packageManager": "pnpm@10.8.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		],
		"peerDependencyRules": {
			"allowedVersions": {
				"@cloudflare/workers-types": "*",
				"@cloudflare/codemode": "*",
				"typescript": "*",
				"vite": "*",
				"zod": "*"
			}
		},
		"overrides": {
			"axios": "1.18.0",
			"@cloudflare/workers-types": "5.20260730.1",
			"esbuild": "0.27.3",
			"oxfmt": "0.31.0",
			"oxlint": "1.46.0",
			"tsx": "4.22.4",
			"typescript": "5.5.4",
			"vitest": "4.1.8",
			"@vitest/coverage-istanbul": "4.1.8",
			"@vitest/ui": "4.1.8",
			"ws": "8.21.0",
			"@types/node": "22.15.17"
		}
	}
}
