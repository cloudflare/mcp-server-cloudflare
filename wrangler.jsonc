{
  "name": "mcp-codemode-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "AGENT", "class_name": "DashboardAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DashboardAgent"] }
  ],
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true }
  }
}
